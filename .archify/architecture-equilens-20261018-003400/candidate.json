  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend Client Tier",
      "items": [
        "Vite 8 SPA built with React 19, Tailwind CSS, Lucide icons, and Recharts",
        "ClerkProvider authenticates users and mints verified JWT session tokens",
        "Axios request interceptor dynamically injects tokens on protected API calls"
      ]
    },
    {
      "dot": "emerald",
      "title": "API Gateway & Security",
      "items": [
        "Express API gateway secured by Helmet headers, strict CORS, and rate limits",
        "Dual rate limiters: 100 req/15min global, 10 req/15min on auth endpoints",
        "Clerk JWT middleware validates tokens and verifies email status before DB sync"
      ]
    },
    {
      "dot": "violet",
      "title": "Multi-LLM Agentic Pipeline",
      "items": [
        "Symbol resolver filters private entities (SpaceX, OpenAI) and resolves tickers",
        "Parallel financial data ingestion via FMP (profile, TTM ratios, income statements)",
        "Real-time news search and source extraction using Tavily Search API",
        "Google Gemini 2.5 Flash primary LLM with automatic Groq Llama-3.3 fallback"
      ]
    },
    {
      "dot": "amber",
      "title": "Database & Persistence",
      "items": [
        "PostgreSQL database managed through Prisma ORM schemas",
        "Atomic Prisma $transaction for company upserts, reports, news, and search history",
        "Multi-tenant queries strictly scoped by userId to eliminate IDOR vulnerabilities"
      ]
    }
  ]
